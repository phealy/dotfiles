# start tmux {{{
[[ $- == *i* && -x "$(command -v tmux)" && -z "$TMUX" && -z "$SSH_CONNECTION" && -z "$AZURE_HTTP_USER_AGENT" && -z "$VSCODE_IPC_HOOK_CLI" && $XDG_VTNR -ne 6 ]] && exec $HOME/.local/bin/tmx
# }}}
# commonrc {{{
source ~/.commonrc
# }}}
# bash config options; history, vi mode; etc {{{
HISTCONTROL=ignoreboth
HISTSIZE=100000
HISTFILESIZE=200000
shopt -s histappend
shopt -s checkwinsize
shopt -s globstar
set -o vi
# }}}
# completion {{{
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi
[ -d ~/.bash_completion.d ] && for c in ~/.bash_completion.d/*; do source $c; done
[ -f /etc/bash_completion.d/azure_cli ] && source /etc/bash_completion.d/azure_cli 2>/dev/null
# }}}
