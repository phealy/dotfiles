# powerline {{{
command -v powerline-daemon &>/dev/null && {
  powerline-daemon -q
  POWERLINE_BASH_CONTINUATION=1
  POWERLINE_BASH_SELECT=1
  . $POWERLINE_PATH/bindings/bash/powerline.sh
}
