[".local/bin/asdf"]
    type = "archive-file"
    url = {{ gitHubLatestReleaseAssetURL "asdf-vm/asdf" (printf "asdf-v*-%s-%s.tar.gz" .chezmoi.os .chezmoi.arch) | quote }}
    path = "asdf"
    executable = true
    private = true
    refreshPeriod = "168h"
[".local/lib/oh-my-zsh"]
    type = "git-repo"
    clone.args = ["--depth", "1"]
    url = "https://github.com/ohmyzsh/ohmyzsh.git"
    refreshPeriod = "168h"
[".local/lib/oh-my-zsh-custom/plugins/zsh-autosuggestions"]
    type = "git-repo"
    clone.args = ["--depth", "1"]
    url = "https://github.com/zsh-users/zsh-autosuggestions.git"
    refreshPeriod = "168h"
[".local/lib/oh-my-zsh-custom/plugins/zsh-syntax-highlighting"]
    type = "git-repo"
    clone.args = ["--depth", "1"]
    url = "https://github.com/zsh-users/zsh-syntax-highlighting.git"
    refreshPeriod = "168h"
[".local/lib/oh-my-zsh-custom/themes/powerlevel10k"]
    type = "git-repo"
    clone.args = ["--depth", "1"]
    url = "https://github.com/romkatv/powerlevel10k.git"
    refreshPeriod = "168h"
[".tmux/plugins/tpm"]
    type = "git-repo"
    clone.args = ["--depth", "1"]
    url = "https://github.com/tmux-plugins/tpm.git"
    refreshPeriod = "168h"
[".vim/pack/plugins/start/vim-bracketed-paste"]
    type = "git-repo"
    clone.args = ["--depth", "1"]
    url = "https://github.com/ConradIrwin/vim-bracketed-paste.git"
    refreshPeriod = "168h"
{{- if eq .machineType "work" }}
[".local/bin/kubectl-unbounded"]
    type = "archive-file"
    url = "https://github.com/Azure/unbounded/releases/latest/download/kubectl-unbounded-linux-amd64.tar.gz"
    path = "kubectl-unbounded"
    executable = true
    private = true
    refreshPeriod = "24h"
{{ end -}}
