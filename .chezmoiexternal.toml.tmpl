{{- $miseArch := "" -}}
{{- if eq .chezmoi.arch "amd64" }}{{ $miseArch = "x64" }}{{ else }}{{ $miseArch = .chezmoi.arch }}{{ end -}}
{{- $miseUrl := gitHubLatestReleaseAssetURL "jdx/mise" (printf "mise-v*-%s-%s" .chezmoi.os $miseArch) -}}
{{- $chezmoiUrl := gitHubLatestReleaseAssetURL "twpayne/chezmoi" (printf "chezmoi-%s-%s" .chezmoi.os .chezmoi.arch) -}}
{{- if ne $chezmoiUrl "" -}}
[".local/bin/chezmoi"]
    type = "file"
    URL = {{ $chezmoiUrl | quote }}
    path = "chezmoi"
    executable = true
    private = true
    refreshPeriod = "168h"
{{ end -}}
{{- if ne $miseUrl "" -}}
[".local/bin/mise"]
    type = "file"
    URL = {{ $miseUrl | quote }}
    path = "mise"
    executable = true
    private = true
    refreshPeriod = "168h"
{{ end -}}
