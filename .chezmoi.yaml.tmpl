{{- $machineTypes := list "personal" "work" "container" -}}
{{- $machineType := "" -}}
{{- if stat (joinPath .chezmoi.homeDir ".cmcontainer") -}}
    {{- $machineType := "container" -}}
{{- else if eq .chezmoi.username "phealy" -}}
    {{- $machineType := promptChoiceOnce . "machineType" "Is this a personal or work machine?" $machineTypes "work" -}}
{{- else if eq .chezmoi.username "pahealy" -}}
    {{- $machineType := promptChoiceOnce . "machineType" "Is this a personal or work machine?" $machineTypes "personal" -}}
{{- end -}}
{{- $ageKeyPath := joinPath .chezmoi.homeDir ".config" "chezmoi-age" "encrypt.key" -}}
{{- $email := "" -}}
{{- if eq $machineType "personal" -}}
    {{- $email = "phealy@phealy.com" -}}
{{- else -}}
    {{- $email = "patrick.healy@microsoft.com" -}}
{{- end -}}
{{ if stat $ageKeyPath }}encryption: age
age:
    identity: {{ $ageKeyPath }}
    recipient: {{ output "awk" "-F" ": " "/public key/ {print $2}" $ageKeyPath }}
{{- end }}
chezmoi:
    progress: true
    add:
        secrets: error
{{ if eq $machineType "work" }}azureKeyVault:
    defaultVault: pahealyaks
{{- end }}
data:
{{ if stat $ageKeyPath }}    ageKeyPath: {{ $ageKeyPath }}{{ end }}
    machineType: {{ $machineType | quote }}
    name: "Patrick W. Healy"
    email: {{ $email | quote }}
{{ if eq $machineType "work" }}    goTools:
        - name: github.com/phealy/git-credential-azure-cli
          version: v0.1.4
          goproxy: false
          goauth: false
{{- end }}

merge:
  command: "bash"
  args:
  - "-c"
  - '{{ `cp {{ .Target | quote }} {{ printf "%s.base" .Target | quote }} && code --new-window --wait --merge {{ .Destination | quote }} {{ .Target | quote }} {{ printf "%s.base" .Target | quote }} {{ .Source | quote }}` }}'

