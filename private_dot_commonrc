function tmpsh {
    DIRECTORY="$(mktemp -p "$(pwd)" -d)" && { 
        trap 'rm -vrf "${DIRECTORY}"' EXIT
        printf 'Entering temporary directory; ctrl-d to exit shell and clean up.\n'
        if [[ ! -z "$*" ]]; then
            cp -v "$*" "$DIRECTORY"
        fi
        pushd "$DIRECTORY" >/dev/null
        $SHELL
        popd >/dev/null
    }
}
