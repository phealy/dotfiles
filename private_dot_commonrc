# update-kubeconfig {{{
function update-kubeconfig {
  CURRENT_SHELL=$(awk '/PPid/ { cmd="readlink /proc/"$2"/exe"; cmd | getline path; print path }' /proc/thread-self/status)
  if [ "${CURRENT_SHELL#*zsh}" != "$CURRENT_SHELL" ]; then
    export KUBECONFIG=$((grep -Els '^kind: Config$' ~/.kube/* ~/.kube/config.d/**/*(N)) 2>/dev/null | paste -sd':')
  elif [ "${CURRENT_SHELL#*bash}" != "$CURRENT_SHELL" ]; then
    export KUBECONFIG=$((grep -Els '^kind: Config$' ~/.kube/* ~/.kube/config.d/**/*) 2>/dev/null | paste -sd':')
  fi
}
update-kubeconfig
