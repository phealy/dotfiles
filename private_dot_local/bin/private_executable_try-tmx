#! /bin/bash

# try-tmx
#
# A script to attempt to connect to home.phealy.com via various hostnames, checking connectivity
# first to prevent long timeouts.

export HOSTS=(home.corgi-symmetric.ts.net home.phealy.com 199.27.255.101 10.0.23.20)
export TEST_TIMEOUT=3

# Check if we're running in termux, then check missing packages {{{
if [[ ! -z "${TERMUX_APP_VERSION}" ]]; then
  TERMUX_INSTALL=()
  command -v mosh &>/dev/null || TERMUX_INSTALL+="mosh"
  command -v nc &>/dev/null || TERMUX_INSTALL+="nmap"
  command -v ssh &>/dev/null || TERMUX_INSTALL+="openssh"
  if [[ ! -z "${TERMUX_INSTALL}" ]]; then
    printf "Installing missing required termux packages: ${TERMUX_INSTALL}\n"
    pkg install ${TERMUX_INSTALL}
  fi
fi
# }}}
# Start wsl-ssh-agent-relay if we're in WSL and it's not running {{{
if [[ ! -S "${SSH_AUTH_SOCK}" && ! -z "${WSL_INTEROP}" && -S ${HOME}/.ssh/wsl-ssh-agent.sock ]]; then
  $HOME/.local/bin/wsl-ssh-agent-relay start
  export SSH_AUTH_SOCK=${HOME}/.ssh/wsl-ssh-agent.sock

  printf 'Waiting for WSL SSH agent to be running and have keys..'
  until ssh-add -L >/dev/null 2>&1; do
    printf '.'
    sleep 1
  done
  printf 'done.\n'
fi
# }}}
# Determine what we can use to test connectivity {{{
if (command -v nc &>/dev/null); then
  TEST_PROGRAM="nc"
  TEST_COMMAND='nc -vzw${TEST_TIMEOUT} "$1" 22'
elif (command -v ssh-keyscan &>/dev/null); then
  TEST_PROGRAM="ssh-keyscan"
  TEST_COMMAND='ssh-keyscan -ted25519 -T${TEST_TIMEOUT} "$1"'
fi

test_connection() {
  printf "Checking $HOST:\n"
  if [[ ! "$HOST" =~ "^(([01]?[0-9]{1,2}|2[0-4][0-9]|25[0-5])\.){3}([01]?[0-9]?[0-9]|2[0-4][0-9]|25[0-5])$" ]]; then
    printf -- "- DNS resolution: "
    if getent hosts $HOST &>/dev/null; then
      printf "success.\n"
    else
      printf "failed.\n"
      return 1
    fi
  fi

  printf -- "- Connectivity via $TEST_PROGRAM: "
  OUTPUT=$(eval ${TEST_COMMAND} 2>&1)
  RC=$?
  if [ $RC -eq 0 ]; then
    printf "successful.\n"
  else
    printf "\n"
    <<<"${OUTPUT}" sed -e "s/^/- /"
  fi
  return $RC
}
# }}}

for HOST in "${HOSTS[@]}"; do
  if [[ ! -z "${TEST_PROGRAM}" ]]; then
    if (test_connection $HOST); then
      printf -- "- Starting mosh..."
      mosh "phealy@${HOST}" /home/phealy/.local/bin/tmx
      exit $?
    fi
  else
    mosh "phealy@${HOST}" /home/phealy/.local/bin/tmx
  fi
>>>>>>> c5c6aff0f053c31c7b5f7dc5636c027181bf1834
done

