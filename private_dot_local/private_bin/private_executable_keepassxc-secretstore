#!/usr/bin/env bash
# Launch KeePassXC, decrypting the database password from the TPM via clevis.
# KeePassXC is single-instance, so running this while it's already open simply
# restores/raises the existing instance.
# Wait for the secret store collection to be unlocked before querying it, so
# secret-tool doesn't fail or hang while the store is still locked.
keychain-state() {
    dbus-send --session --print-reply=literal \
    --dest=org.freedesktop.secrets /org/freedesktop/secrets/aliases/default \
    org.freedesktop.DBus.Properties.Get \
    string:org.freedesktop.Secret.Collection string:Locked 2>/dev/null
}

if [[ "$(keychain-state)" == *"boolean true"* ]]; then
    printf "Waiting for keychain to be unlocked: "
    until [[ "$(keychain-state)" == *"boolean false"* ]]; do
        printf "."
        sleep 1
    done
    printf "done.\n"
fi

secret-tool lookup app keepassxc \
    | XDG_SESSION_TYPE="" QT_QPA_PLATFORM=wayland keepassxc --minimized --pw-stdin ~/Documents/Keepass.kdbx &>/dev/null &
disown %1
