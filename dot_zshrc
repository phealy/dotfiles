source $HOME/.commonrc
# }}}
# Set ASDF settings {{{
. ${ASDF_DATA_DIR:-$HOME/.asdf}/plugins/golang/set-env.zsh
# }}}
# cfg alias completion {{{
unalias cfg
cfg() {
    GIT_DIR=$HOME/.cfg GIT_WORK_TREE=$HOME command git "$@"
}
_cfg() {
    # Use _files for 'cfg add' since showUntrackedFiles is off in .cfg
    if [[ ${words[2]} == "add" ]]; then
        shift words
        (( CURRENT-- ))
        _files
    else
        local service=git
        words[1]=git
        GIT_DIR=$HOME/.cfg GIT_WORK_TREE=$HOME _git
    fi
}
compdef _cfg cfg
# }}}
