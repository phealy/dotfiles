[user]
	email = {{ .email }}
	name = {{ .name }}
[push]
	default = simple
[submodule]
	recurse = true
[init]
	defaultBranch = main
[credential]
	helper = cache
{{- if and (eq .machineType "work") (not (empty (lookPath "asdf"))) (not (empty (lookPath "go"))) }}
{{- print "\n\thelper = " (joinPath (output "asdf" "where" "golang") "bin" "git-credential-azure-cli") }}
[azureCliCredentialHelper]
	allowedDomain = visualstudio.com
	allowedDomain = dev.azure.com
	allowedDomain = goproxyprod.goms.io
[azureCliCredentialHelper "https://goproxyprod.goms.io"]
	resource = https://microsoft.onmicrosoft.com/AKSGoProxyMSFT
{{ end }}
